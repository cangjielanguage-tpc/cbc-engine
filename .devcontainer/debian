FROM --platform=linux/amd64 debian:stable-slim AS base

RUN apt update && apt install -y \
    git \
    vim \
    curl \
    wget \
    gcc \
    g++ \
    unzip \
    gzip \
    unzip \
    make \
    cmake \
    bash \
    fish \
    ccls \
    clang-19 \
    lld-19 \
    lldb-19 \
    gdb \
    rsync \
    openjdk-21-jre \
    clang-format

RUN dpkg --add-architecture arm64 && \
    apt update && apt install -y \
    libc6-dev:arm64 \
    linux-libc-dev:arm64 \
    libstdc++-12-dev:arm64

RUN mkdir -p /third-party && cd /third-party && \
    wget --no-check-certificate https://github.com/google/googletest/archive/refs/tags/v1.14.0.tar.gz && \
    tar -xvzf v1.14.0.tar.gz

ENV LLVM_BIN="/usr/lib/llvm-19/bin/"
ENV PATH="${LLVM_BIN}:${PATH}"

ENV CC=${LLVM_BIN}/clang
ENV CXX=${LLVM_BIN}/clang++

ENV LOCAL_GOOGLETESTS_PATH="/third-party/googletest-1.14.0/"
