{
	"build": {
		"dockerfile": "alpine_amd64"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cmake-tools",
				"ccls-project.ccls"
			],
			"settings": {
				"C_Cpp.errorSquiggles": "disabled"
			}
		}
	},
	"postCreateCommand": "git config core.hooksPath .githooks",
	"forwardPorts": [3000]
}
